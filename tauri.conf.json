{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Altair_module_system_control",
  "version": "2.0.5",
  "identifier": "io.github.altairu.modulecontrol",
  "build": {
    "devUrl": "http://127.0.0.1:8000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Altair_module_system_control",
        "url": "http://127.0.0.1:8000",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}

